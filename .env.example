# ═══════════════════════════════════════════════════════════
# SIGA — Variáveis de Ambiente — Arquivo de Exemplo
# ═══════════════════════════════════════════════════════════
#
# INSTRUÇÕES:
# 1. Copie este arquivo para ".env.local" ou ".env" em desenvolvimento
# 2. Preencha os valores específicos do seu ambiente
# 3. NUNCA versionize arquivos .env com valores reais em repositórios públicos
#
# ───────────────────────────────────────────────────────────
# BACKEND (LOCAL)
# ───────────────────────────────────────────────────────────

# Endereço de escuta do backend (0.0.0.0 para Docker, 127.0.0.1 para local)
HOST=127.0.0.1

# Porta do servidor backend
PORT=3000

# Arquivo de dados local (desenvolvimento)
# Em Docker: /data/local-data.json (mapeado via volume ./data:/data)
SIGA_DATA_FILE=./data/local-data.json

# Limite de tamanho de body em requisições HTTP (em bytes)
# Padrão: 52428800 (50MB) — aumentado para suportar upload de arquivos
SIGA_MAX_BODY_BYTES=52428800

# ───────────────────────────────────────────────────────────
# INTELIGÊNCIA ARTIFICIAL
# ───────────────────────────────────────────────────────────

# Provider de IA: "azure" (Azure OpenAI, padrão) ou "github" (GitHub Models)
SIGA_AI_PROVIDER=azure

# --- Azure OpenAI (produção) ---
SIGA_AZURE_ENDPOINT=https://projeto-gesproc-cage.cognitiveservices.azure.com
SIGA_AZURE_DEPLOYMENT=gpt-5.1-chat
SIGA_AZURE_API_VERSION=2024-12-01-preview
# SIGA_AZURE_API_KEY=

# --- GitHub Models (fallback/desenvolvimento) ---
# Token de acesso — gere em: https://github.com/settings/tokens (escopo model:read)
# SIGA_AI_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Modelo padrão para GitHub Models (quando provider=github)
SIGA_AI_MODEL=openai/gpt-4.1-mini

# ───────────────────────────────────────────────────────────
# SEGURANÇA CORS (Cross-Origin)
# ───────────────────────────────────────────────────────────

# Origem permitida para requisições CORS
# Exemplo em desenvolvimento: http://localhost:5173
# Exemplo em produção: https://siga.sefaz.rs.gov.br
# IMPORTANTE: nunca use '*' em produção
SIGA_ALLOWED_ORIGIN=http://localhost:5173

# ───────────────────────────────────────────────────────────
# AUTENTICAÇÃO (Microsoft Entra ID / Azure AD)
# ───────────────────────────────────────────────────────────

# Modo de autenticação: 'local' (desenvolvimento) ou 'entra' (produção)
SIGA_AUTH_MODE=local

# Tenant ID do Microsoft Entra
# Obtém em: https://portal.azure.com → Entra ID → Propriedades
ENTRA_TENANT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# ID da aplicação (client ID) registrada no Entra para backend/API
ENTRA_CLIENT_ID_API=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Audience (identificador da API) — normalmente igual ao URL da API
ENTRA_AUDIENCE=http://localhost:3000

# ───────────────────────────────────────────────────────────
# BANCO DE DADOS (Azure SQL / SQL Server)
# ───────────────────────────────────────────────────────────

# Servidor SQL (FQDN ou IP:porta)
SQL_SERVER=localhost

# Nome do banco de dados
SQL_DATABASE=siga

# Usuário SQL para conexão
SQL_USER=sa

# Senha do usuário SQL — NUNCA use sa em produção
SQL_PASSWORD=P@ssw0rdSeguro1234

# ───────────────────────────────────────────────────────────
# LOGGING E MONITORAMENTO
# ───────────────────────────────────────────────────────────

# Nível de log: debug, info, warn, error
LOG_LEVEL=info

# URL de Application Insights (Azure Monitor)
# SIGA_APPINSIGHTS_URL=https://eastus-1.in.applicationinsights.azure.com/api/internal/logs

# ───────────────────────────────────────────────────────────
# NODE / NPM
# ───────────────────────────────────────────────────────────

# Ambiente de execução
NODE_ENV=development

# Token NPM (para instalar pacotes privados, se houver)
# NPM_TOKEN=npm_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
