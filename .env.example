# ============================================================
# SIGA — Variáveis de Ambiente
# Copie este arquivo para .env e preencha os valores.
# O arquivo .env nunca deve ser commitado ao repositório.
# ============================================================

# ── Servidor ──────────────────────────────────────────────
# Endereço de escuta do backend (0.0.0.0 para Docker, 127.0.0.1 para local)
HOST=127.0.0.1

# Porta do backend
PORT=3000

# ── Dados ─────────────────────────────────────────────────
# Caminho para o arquivo JSON de persistência de dados
# Padrão local: <raiz>/backups/local-data.json
# Padrão Docker: /data/local-data.json
# SIGA_DATA_FILE=/data/local-data.json

# Tamanho máximo do corpo de requisição em bytes (padrão: 50 MB)
SIGA_MAX_BODY_BYTES=52428800

# ── CORS ──────────────────────────────────────────────────
# Origens permitidas, separadas por vírgula.
# Deixe em branco para permitir apenas localhost.
# Exemplo: SIGA_ALLOWED_ORIGIN=https://siga.sefaz.rs.gov.br,https://siga-hml.sefaz.rs.gov.br
# SIGA_ALLOWED_ORIGIN=

# ── IA / Assistente ───────────────────────────────────────
# Provider de IA: "ai" (GitHub Models) ou "google" (Gemini)
SIGA_AI_PROVIDER=ai

# Token de autenticação do provider de IA
# Para GitHub Models: Personal Access Token com permissão de leitura de modelos
# Para Google Gemini: API Key do Google AI Studio
# SIGA_AI_TOKEN=

# Chave de API alternativa (usada quando SIGA_AI_PROVIDER=google)
# SIGA_AI_API_KEY=

# Endpoint da API de IA (padrão: GitHub Models)
SIGA_AI_API_URL=https://models.github.ai/inference/chat/completions

# Modelo principal a utilizar
SIGA_AI_MODEL=openai/gpt-4.1-mini

# Modelos de fallback, separados por vírgula (tentados em ordem se o principal falhar)
# SIGA_AI_FALLBACK_MODELS=openai/gpt-4o-mini,meta/llama-3.1-8b-instruct
